{
  "name": "eds-diary",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "body-map:generate": "node scripts/generate-body-map-pngs.mjs",
    "predev": "npm run body-map:generate",
    "dev": "vite",
    "prebuild": "npm run body-map:generate",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "prestorybook": "npm run body-map:generate",
    "storybook": "storybook dev -p 6006",
    "prebuild-storybook": "npm run body-map:generate",
    "build-storybook": "storybook build",
    "test:e2e": "playwright test",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:architecture": "vitest run src/test/architecture.test.ts",
    "test:live-google-parallel-append": "node scripts/live-google-parallel-append-gate.mjs",
    "test:security-unit": "vitest run src/test/crypto.test.ts src/test/protocol-vectors.test.ts src/test/v2Primitives.test.ts src/test/v2Verifier.test.ts src/test/v2LocalState.test.ts src/test/v2ReadOnlyJoin.test.ts src/test/profileUpgradeV2StateMachine.test.ts src/test/syncManager.test.ts",
    "test:security-e2e": "playwright test tests/google-auth-handoff.spec.ts tests/multi-device-harness.spec.ts tests/security-product-flows.spec.ts tests/webauthn-prf.spec.ts --project=chromium",
    "test:release": "npm run lint && npm run build && npm run test:unit && npm run test:security-e2e && npm run build-storybook",
    "test:security-generative": "vitest run src/test/stateMachine.test.ts"
  },
  "dependencies": {
    "@noble/hashes": "2.0.1",
    "canonicalize": "^2.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.5.7",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/react-vite": "^10.5.7",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "fake-indexeddb": "6.2.4",
    "globals": "^17.11.0",
    "storybook": "^10.5.7",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~6.0.0-beta",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "4.0.18"
  }
}
