{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "recovery-authority-transition-sw/v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "transition_id",
    "transition_kind",
    "from_recovery_generation",
    "from_recovery_urs_id",
    "from_recovery_takeover_key_id",
    "to_recovery_generation",
    "to_recovery_urs_commitment",
    "to_recovery_urs_id",
    "to_recovery_takeover_key_id",
    "to_recovery_takeover_public_key",
    "authority_anchor"
  ],
  "properties": {
    "transition_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "transition_kind": {
      "const": "recovery_rekey"
    },
    "from_recovery_generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "from_recovery_urs_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "from_recovery_takeover_key_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "to_recovery_generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "to_recovery_urs_commitment": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "to_recovery_urs_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "to_recovery_takeover_key_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "to_recovery_takeover_public_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "authority_anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anchor_profile",
        "covered_row_count",
        "prefix_hash"
      ],
      "properties": {
        "anchor_profile": {
          "const": "google-sheets-transferable-single-writer-v2"
        },
        "covered_row_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "prefix_hash": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        }
      }
    }
  }
}
