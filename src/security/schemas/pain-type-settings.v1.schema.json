{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pain-type-settings/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["values"],
  "properties": {
    "values": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 60, "pattern": "^\\S(?:[\\s\\S]*\\S)?$"}
    }
  }
}
