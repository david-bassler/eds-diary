{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "successor-activation-confirmation-sw/v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "confirmation_id",
    "activation_kind",
    "source_profile",
    "source_epoch_id",
    "source_manifest_fingerprint",
    "source_anchor_before_announcement",
    "successor_epoch_id",
    "successor_manifest_fingerprint",
    "successor_staging_anchor",
    "source_announcement_envelope_sha256"
  ],
  "properties": {
    "confirmation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "activation_kind": {
      "enum": [
        "profile_upgrade",
        "v2_rotation"
      ]
    },
    "source_profile": {
      "enum": [
        "google-sheets-single-writer-v1",
        "google-sheets-transferable-single-writer-v2"
      ]
    },
    "source_epoch_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22}$"
    },
    "source_manifest_fingerprint": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "source_anchor_before_announcement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anchor_profile",
        "covered_row_count",
        "prefix_hash"
      ],
      "properties": {
        "anchor_profile": {
          "enum": [
            "google-sheets-single-writer-v1",
            "google-sheets-transferable-single-writer-v2"
          ]
        },
        "covered_row_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "prefix_hash": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        }
      }
    },
    "successor_epoch_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22}$"
    },
    "successor_manifest_fingerprint": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "successor_staging_anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anchor_profile",
        "covered_row_count",
        "prefix_hash"
      ],
      "properties": {
        "anchor_profile": {
          "const": "google-sheets-transferable-single-writer-v2"
        },
        "covered_row_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "prefix_hash": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        }
      }
    },
    "source_announcement_envelope_sha256": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "activation_kind": {
            "const": "profile_upgrade"
          }
        },
        "required": [
          "activation_kind"
        ]
      },
      "then": {
        "properties": {
          "source_profile": {
            "const": "google-sheets-single-writer-v1"
          },
          "source_anchor_before_announcement": {
            "properties": {
              "anchor_profile": {
                "const": "google-sheets-single-writer-v1"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "activation_kind": {
            "const": "v2_rotation"
          }
        },
        "required": [
          "activation_kind"
        ]
      },
      "then": {
        "properties": {
          "source_profile": {
            "const": "google-sheets-transferable-single-writer-v2"
          },
          "source_anchor_before_announcement": {
            "properties": {
              "anchor_profile": {
                "const": "google-sheets-transferable-single-writer-v2"
              }
            }
          }
        }
      }
    }
  ]
}
