{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rotation-announcement-sw/v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rotation_id",
    "from_epoch_id",
    "successor_epoch_id",
    "successor_creation_locator",
    "successor_manifest_fingerprint",
    "rotation_kind",
    "source_writer_generation",
    "source_writer_grant_id",
    "successor_recovery_generation",
    "source_anchor_before_announcement",
    "recovery_transition_id"
  ],
  "properties": {
    "rotation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "from_epoch_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22}$"
    },
    "successor_epoch_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22}$"
    },
    "successor_creation_locator": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22}$"
    },
    "successor_manifest_fingerprint": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "rotation_kind": {
      "enum": [
        "normal",
        "recovery_rekey"
      ]
    },
    "source_writer_generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "source_writer_grant_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "successor_recovery_generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "source_anchor_before_announcement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anchor_profile",
        "covered_row_count",
        "prefix_hash"
      ],
      "properties": {
        "anchor_profile": {
          "const": "google-sheets-transferable-single-writer-v2"
        },
        "covered_row_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "prefix_hash": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        }
      }
    },
    "recovery_transition_id": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        }
      ]
    }
  }
}
